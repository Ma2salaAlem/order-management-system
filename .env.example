# Copy this file to .env and fill in real values before running the app.

# Postgres connection string. If you use the included docker-compose.yml
# as-is, this default value already matches it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kds_db?schema=public"

# Any long random string — used to sign/verify JWTs for both HTTP and
# Socket.io auth. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_string"

PORT=4000

# Origin allowed to open Socket.io / CORS connections. "*" is fine for
# local testing; lock this to your real frontend origin in production.
CLIENT_ORIGIN="*"
